---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  zoomable?: boolean;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, zoomable = false, ...rest } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  {...rest}
  {...(zoomable ? { 'data-zoomable': '' } : {})}
/>
